---
const navLinks = [
  { href: '/work', label: 'Work' },
  { href: '/studio', label: 'Studio' },
  { href: '/journal', label: 'Journal' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/map', label: 'Map' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-40 bg-paper transition-all duration-300"
  aria-label="Site header"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-10">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a
        href="/"
        class="font-serif italic text-xl lg:text-2xl text-ink hover:text-accent transition-colors duration-200 tracking-tight"
        aria-label="Lumen Atelier — Home"
      >
        Lumen Atelier
      </a>

      <!-- Desktop Navigation -->
      <nav aria-label="Primary navigation" class="hidden lg:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`text-sm tracking-wide transition-colors duration-200 relative group ${
              currentPath === link.href || currentPath.startsWith(link.href + '/')
                ? 'text-ink font-medium'
                : 'text-subtle hover:text-ink'
            }`}
            aria-current={currentPath === link.href || currentPath.startsWith(link.href + '/') ? 'page' : undefined}
          >
            {link.label}
            <span
              class={`absolute -bottom-1 left-0 h-px bg-accent transition-all duration-200 ${
                currentPath === link.href || currentPath.startsWith(link.href + '/')
                  ? 'w-full'
                  : 'w-0 group-hover:w-full'
              }`}
            ></span>
          </a>
        ))}
      </nav>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open navigation menu"
        class="lg:hidden flex flex-col gap-1.5 p-2 -mr-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        <span class="hamburger-line block w-6 h-px bg-ink transition-all duration-300 origin-center"></span>
        <span class="hamburger-line block w-6 h-px bg-ink transition-all duration-300"></span>
        <span class="hamburger-line block w-4 h-px bg-ink transition-all duration-300 origin-center"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div
    id="mobile-menu"
    class="lg:hidden overflow-hidden max-h-0 transition-all duration-300 ease-in-out"
    aria-hidden="true"
  >
    <nav
      aria-label="Mobile navigation"
      class="px-6 pb-6 pt-2 border-t border-hairline"
    >
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`block py-3 text-base border-b border-hairline transition-colors duration-200 last:border-b-0 ${
            currentPath === link.href || currentPath.startsWith(link.href + '/')
              ? 'text-ink font-medium'
              : 'text-subtle hover:text-ink'
          }`}
          aria-current={currentPath === link.href || currentPath.startsWith(link.href + '/') ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<!-- Spacer to push content below fixed header -->
<div class="h-16 lg:h-20" aria-hidden="true"></div>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerLines = document.querySelectorAll('.hamburger-line');
  let menuOpen = false;

  // Scroll behavior: add border-bottom when scrolled
  function handleScroll() {
    if (!header) return;
    if (window.scrollY > 20) {
      header.style.borderBottom = '1px solid var(--hairline)';
    } else {
      header.style.borderBottom = 'none';
    }
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  // Mobile menu toggle
  toggle?.addEventListener('click', () => {
    menuOpen = !menuOpen;
    toggle.setAttribute('aria-expanded', String(menuOpen));
    toggle.setAttribute('aria-label', menuOpen ? 'Close navigation menu' : 'Open navigation menu');

    if (mobileMenu) {
      mobileMenu.setAttribute('aria-hidden', String(!menuOpen));
      if (menuOpen) {
        mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
      } else {
        mobileMenu.style.maxHeight = '0';
      }
    }

    // Animate hamburger to X
    if (hamburgerLines.length === 3) {
      const [top, mid, bot] = Array.from(hamburgerLines) as HTMLElement[];
      if (menuOpen) {
        top.style.transform = 'translateY(7.5px) rotate(45deg)';
        mid.style.opacity = '0';
        bot.style.width = '24px';
        bot.style.transform = 'translateY(-7.5px) rotate(-45deg)';
      } else {
        top.style.transform = '';
        mid.style.opacity = '1';
        bot.style.width = '';
        bot.style.transform = '';
      }
    }
  });

  // Close mobile menu on outside click
  document.addEventListener('click', (e) => {
    if (!menuOpen) return;
    const target = e.target as Node;
    if (!header?.contains(target)) {
      menuOpen = false;
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open navigation menu');
      if (mobileMenu) {
        mobileMenu.setAttribute('aria-hidden', 'true');
        mobileMenu.style.maxHeight = '0';
      }
      if (hamburgerLines.length === 3) {
        const [top, mid, bot] = Array.from(hamburgerLines) as HTMLElement[];
        top.style.transform = '';
        mid.style.opacity = '1';
        bot.style.width = '';
        bot.style.transform = '';
      }
    }
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuOpen) {
      menuOpen = false;
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Open navigation menu');
      if (mobileMenu) {
        mobileMenu.setAttribute('aria-hidden', 'true');
        mobileMenu.style.maxHeight = '0';
      }
      if (hamburgerLines.length === 3) {
        const [top, mid, bot] = Array.from(hamburgerLines) as HTMLElement[];
        top.style.transform = '';
        mid.style.opacity = '1';
        bot.style.width = '';
        bot.style.transform = '';
      }
      toggle?.focus();
    }
  });
</script>
