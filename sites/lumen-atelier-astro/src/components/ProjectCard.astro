---
export interface Props {
  title: string;
  client: string;
  year: number;
  tags: string[];
  slug: string;
  excerpt: string;
  featured?: boolean;
  index?: number;
}

const {
  title,
  client,
  year,
  tags,
  slug,
  excerpt,
  featured = false,
  index = 0,
} = Astro.props;

// Generate a gradient for the image placeholder based on client initial
const initial = client.charAt(0).toUpperCase();
const gradients = [
  'from-accent/20 to-highlight/30',
  'from-accent-2/20 to-accent/10',
  'from-highlight/20 to-hairline',
  'from-subtle/20 to-accent/15',
  'from-accent/15 to-accent-2/20',
  'from-hairline to-highlight/20',
];
const gradientClass = gradients[index % gradients.length];

// CSS gradient fallback colors since we can't use arbitrary Tailwind in dynamic strings
const bgColors = [
  'background: linear-gradient(135deg, rgba(196,93,61,0.15) 0%, rgba(217,182,94,0.25) 100%)',
  'background: linear-gradient(135deg, rgba(46,74,217,0.15) 0%, rgba(196,93,61,0.08) 100%)',
  'background: linear-gradient(135deg, rgba(217,182,94,0.18) 0%, rgba(231,222,211,0.8) 100%)',
  'background: linear-gradient(135deg, rgba(110,103,96,0.15) 0%, rgba(196,93,61,0.12) 100%)',
  'background: linear-gradient(135deg, rgba(196,93,61,0.12) 0%, rgba(46,74,217,0.15) 100%)',
  'background: linear-gradient(135deg, rgba(231,222,211,0.9) 0%, rgba(217,182,94,0.18) 100%)',
];
const bgStyle = bgColors[index % bgColors.length];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<article class={`group ${featured ? 'featured-card' : ''}`} data-tags={tags.join(',')}>
  <a href={`${base}/work/${slug}`} class="block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
    <!-- Image placeholder -->
    <div
      class="relative aspect-[4/3] overflow-hidden mb-5"
      style={bgStyle}
      aria-hidden="true"
    >
      <!-- Large initial letter as visual element -->
      <span
        class="absolute inset-0 flex items-center justify-center font-serif text-8xl lg:text-9xl font-normal select-none"
        style="color: rgba(20,19,18,0.08); letter-spacing: -0.05em;"
      >
        {initial}
      </span>
      <!-- Hover overlay -->
      <div
        class="absolute inset-0 bg-ink/0 group-hover:bg-ink/5 transition-colors duration-300"
      ></div>
      <!-- Year badge -->
      <div class="absolute top-4 right-4">
        <span class="text-xs font-sans tracking-wide text-subtle bg-paper/90 px-2 py-1">
          {year}
        </span>
      </div>
    </div>

    <!-- Card content -->
    <div>
      <p class="text-xs tracking-widest uppercase text-subtle font-sans mb-2">{client}</p>
      <h3
        class={`font-serif font-normal text-ink group-hover:text-accent transition-colors duration-200 mb-3 leading-tight relative ${
          featured ? 'text-2xl lg:text-3xl' : 'text-xl lg:text-2xl'
        }`}
      >
        {title}
        <!-- Terracotta underline on hover -->
        <span
          class="absolute -bottom-1 left-0 h-px bg-accent w-0 group-hover:w-full transition-all duration-300 ease-out"
          aria-hidden="true"
        ></span>
      </h3>
      <p class="text-subtle text-sm leading-relaxed mb-4 line-clamp-2">{excerpt}</p>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="text-xs font-sans text-subtle border border-hairline px-2 py-0.5 tracking-wide">
            {tag}
          </span>
        ))}
      </div>
    </div>
  </a>
</article>
