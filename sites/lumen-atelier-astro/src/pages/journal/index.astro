---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JournalCard from '@/components/JournalCard.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allEntries = await getCollection('journal');
const entries = allEntries.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Collect all unique tags
const allTags = [...new Set(entries.flatMap((e) => e.data.tags))].sort();
---

<BaseLayout
  title="Journal"
  description="Writing on design, brand, and visual thinking from Lumen Atelier."
>
  <!-- Page header -->
  <section class="max-w-7xl mx-auto px-6 lg:px-10 pt-16 pb-12 border-b border-hairline">
    <p class="text-xs tracking-widest uppercase text-subtle font-sans mb-4">Studio writing</p>
    <h1 class="text-5xl lg:text-6xl xl:text-7xl font-serif font-normal text-ink leading-none mb-6">
      Journal
    </h1>
    <p class="text-lg text-subtle font-sans leading-relaxed max-w-xl">
      Writing on design, brand, and visual thinking.
    </p>
  </section>

  <!-- Content area -->
  <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-20">
    <div class="lg:grid lg:grid-cols-[1fr_240px] lg:gap-16 xl:gap-24">
      <!-- Journal list -->
      <main>
        <div class="flex items-baseline justify-between mb-8">
          <p class="text-xs tracking-widest uppercase text-subtle font-sans">
            {entries.length} entries
          </p>
        </div>
        <div>
          {entries.map((entry) => (
            <JournalCard
              title={entry.data.title}
              date={entry.data.date}
              excerpt={entry.data.excerpt}
              tags={entry.data.tags}
              readingTime={entry.data.readingTime}
              slug={entry.slug}
            />
          ))}
        </div>
      </main>

      <!-- Sidebar: tags -->
      <aside class="mt-12 lg:mt-0 lg:sticky lg:top-28 lg:self-start">
        <div>
          <h2 class="text-xs tracking-widest uppercase text-subtle font-sans mb-6">Topics</h2>
          <div class="flex flex-wrap gap-2">
            {allTags.map((tag) => (
              <span class="text-xs font-sans text-subtle border border-hairline px-3 py-1.5 tracking-wide capitalize cursor-default hover:border-ink hover:text-ink transition-colors duration-200">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <div class="mt-10 border-t border-hairline pt-8">
          <h2 class="text-xs tracking-widest uppercase text-subtle font-sans mb-4">About the journal</h2>
          <p class="text-sm font-sans text-subtle leading-relaxed">
            Extended writing on the practice and thinking behind editorial and brand design.
            Published irregularly, written by the studio team.
          </p>
        </div>

        <div class="mt-8 border-t border-hairline pt-8">
          <p class="text-xs tracking-widest uppercase text-subtle font-sans mb-3">New work</p>
          <a
            href={`${base}/contact`}
            class="inline-block text-sm font-sans font-medium bg-accent text-paper px-5 py-2.5 hover:bg-ink transition-colors duration-200"
          >
            Start a project
          </a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
